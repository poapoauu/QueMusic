{
  "id": "org.quemusic.source.navidrome",
  "sourceId": "navidrome",
  "name": "Navidrome",
  "version": "1.0.0",
  "category": "source",
  "runtime": "native-qt",
  "library": "@CMAKE_SHARED_MODULE_PREFIX@quemusic_navidrome_source@CMAKE_SHARED_MODULE_SUFFIX@",
  "pluginApi": {
    "major": 1,
    "minHostMinor": 0
  },
  "interfaces": [
    {
      "id": "org.quemusic.MusicSourcePlugin/2.0",
      "version": "2.0"
    }
  ],
  "runtimeRequirements": {
    "sourceSdkAbi": 2,
    "qtMajor": @Qt6Core_VERSION_MAJOR@,
    "architecture": "@QUEMUSIC_NAVIDROME_ARCHITECTURE@",
    "buildKey": "@QUEMUSIC_NAVIDROME_BUILD_KEY@"
  }
}
